# Google Play licence-test additions for a separate, isolated App configuration.
# The same public origin is used temporarily while the operator tests; this file
# must not replace production settings, the production DB, or production secrets.
GOOGLE_WEB_CLIENT_ID=299375445471-dtll3k3o73sne55b5k9j3mcsk4864i0o.apps.googleusercontent.com
APP_VIP_PAYMENT_ENABLED=true
APPLE_STORE_ENABLED=false
GOOGLE_STORE_ENABLED=true
GOOGLE_STORE_PACKAGE_NAME=com.zhibeii.iwodi
GOOGLE_STORE_PRODUCT_ID=vip
GOOGLE_STORE_ENVIRONMENT=sandbox
GOOGLE_STORE_CLIENT_EMAIL=iwodi-play-verifier@iwodi-play.iam.gserviceaccount.com
GOOGLE_STORE_NOTIFICATION_AUDIENCE=https://iwodi.284264172.xyz/app/store/events/google
GOOGLE_STORE_NOTIFICATION_EMAIL=iwodi-play-push@iwodi-play.iam.gserviceaccount.com

# Example test-only path. Create its separate parent directory and configure
# permissions for the actual service account before starting the test instance.
USER_DB_PATH=/var/lib/qile-wodi-app-license-test/users.sqlite
# Fill with a newly generated independent test secret, never the production one.
AUTH_TOKEN_SECRET=
# GOOGLE_STORE_PRIVATE_KEY is required but intentionally omitted. Use secure
# injection for the verifier key; do not put its value in this repository.
