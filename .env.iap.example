NODE_ENV=production
HOST=127.0.0.1
PORT=3030
CLIENT_ORIGIN=https://servicewechat.com,https://iap.wodi.server.zhibeii.com

WECHAT_APP_ID=your_wechat_app_id
WECHAT_APP_SECRET=your_wechat_app_secret
WECHAT_LOGIN_TIMEOUT_MS=5000

USER_DB_PATH=/var/lib/qile-wodi/iap/users.sqlite
AUTH_TOKEN_SECRET=

HOST_TRANSFER_GRACE_MS=30000
ROOM_ALL_DISCONNECTED_TTL_MS=600000
ROOM_WAITING_IDLE_MS=900000
ROOM_PLAYING_IDLE_MS=600000
ROOM_IDLE_WARNING_MS=60000

VIP_PAYMENT_ENABLED=false
VIP_OFFER_ID=
VIP_APP_KEY=
VIP_PRODUCT_ID=vip_month
VIP_PRICE_FEN=1000
WECHAT_MESSAGE_TOKEN=
WECHAT_MESSAGE_AES_KEY=
