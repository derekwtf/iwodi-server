# 服务监听
HOST=127.0.0.1
PORT=3010
# 运行渠道：省略时为 wechat。独立 App 环境填写 app，不初始化微信登录/支付。
APP_CHANNEL=wechat

# 允许访问后端的前端来源（逗号分隔）
# 本地开发可用 http://127.0.0.1:3000 或 *
# 线上请填写你的小程序请求域名 / 管理端域名
CLIENT_ORIGIN=https://servicewechat.com,https://wodi.server.zhibeii.com

# 微信登录（必须配置，否则 /auth/login 与 /auth/wechat-login 会返回 503）
WECHAT_APP_ID=your_wechat_app_id
WECHAT_APP_SECRET=your_wechat_app_secret
WECHAT_LOGIN_TIMEOUT_MS=5000

# App 登录（APP_CHANNEL=app；未配置的平台返回 503，不能使用假值或开发登录绕过）
# Apple 为 iOS App 的 Bundle ID；Google 为同项目的 Web OAuth Client ID，须与 App 配置一致。
APPLE_CLIENT_ID=
GOOGLE_WEB_CLIENT_ID=
# 经本机 Nginx 等反代时设为 loopback（代理须覆盖 X-Forwarded-For），否则留空，不盲信公网来源头。
APP_TRUST_PROXY=
# 服务器须能通过 HTTPS 访问 appleid.apple.com/auth/keys 和 www.googleapis.com/oauth2/v3/certs。
# App / 微信，以及测试 / 正式，分别使用独立 USER_DB_PATH、AUTH_TOKEN_SECRET、端口和 HTTPS 域名。
# 例如 App 测试库 /var/lib/qile-wodi/app-test/users.sqlite；先创建目录，再从发布目录外加载配置。
# APP_CHANNEL=app 时不会读取 VIP_PAYMENT_* / 微信密钥；App 商店支付通过下方独立开关控制。
# Apple: POST /auth/app-login {"provider":"apple"} 领取 5 分钟一次性 nonce，
# 原样传 signInAsync({nonce})，然后 POST {"provider":"apple","identityToken":"...","nonce":"..."}。
# challenge 每个来源同时最多 10 个；生产入口应保留独立实例和上游请求限流。
# Google: POST /auth/app-login {"provider":"google","identityToken":"..."}。
# 当前 Google 原生 SDK 不提供 nonce；按平台规则校验签名/issuer/audience/期限，凭证仅经 HTTPS 传输。
# 两端可携带 playerId 作为重连建议，身份仍只来自验证通过的平台 sub；不接受邮箱/userId 认领。
# 响应沿用 playerId/userId/profile/membership/token/expiresAt，业务 Socket 使用 {token,playerId}。
# JWKS 缓存仅内存保存；重启后 Apple challenge 失效，需重新授权。真实平台授权另行验收。

# 两种玩法均固定 3～12 人；不提供全局下限覆盖

# 房间空闲/重连相关（按需覆盖）
HOST_TRANSFER_GRACE_MS=30000
ROOM_ALL_DISCONNECTED_TTL_MS=600000
ROOM_WAITING_IDLE_MS=900000
ROOM_PLAYING_IDLE_MS=600000
ROOM_IDLE_WARNING_MS=60000

# 持久账号（目录须预先创建并允许运行用户写入；放在发布目录外）
USER_DB_PATH=/var/lib/qile-wodi/test/users.sqlite
# 使用 openssl rand -hex 32 生成；测试/正式各自独立，跨发布保留
AUTH_TOKEN_SECRET=

# VIP 道具直购（个人主体，现网 env=0；默认关闭售卖，停卖后保留以下全部密钥）
VIP_PAYMENT_ENABLED=false
VIP_OFFER_ID=
VIP_APP_KEY=
# 已在微信后台创建；须发布生效且价格与下方一致
VIP_PRODUCT_ID=vip_month
VIP_PRICE_FEN=1000
# 消息推送：JSON、安全模式，URL 为 https://本环境域名/wechat/events
WECHAT_MESSAGE_TOKEN=
WECHAT_MESSAGE_AES_KEY=

# App 商店：默认停卖；停卖仍保留配置，以便验证历史交易、退款和补偿。
# 独立 App 用户库中运行，禁止与小程序共用库、token secret、应用 ID 或订单。
APP_VIP_PAYMENT_ENABLED=false
# 只开放一个平台时，另一平台明确设为 false。未完整配置不得开放。
APPLE_STORE_ENABLED=false
APPLE_STORE_BUNDLE_ID=
APPLE_STORE_PRODUCT_ID=
APPLE_STORE_ENVIRONMENT=sandbox
APPLE_STORE_ISSUER_ID=
APPLE_STORE_KEY_ID=
# App Store Server API 私钥，换行可写为 \n；不得放进 EXPO_PUBLIC_*。
APPLE_STORE_PRIVATE_KEY=
# 官方 Apple 根证书文件绝对路径，多个逗号分隔；从 Apple PKI 官方站点核对来源。
APPLE_STORE_ROOT_CERTIFICATES=
# App Store Connect 数字应用 ID，production 必填。
APPLE_STORE_APP_ID=
GOOGLE_STORE_ENABLED=false
GOOGLE_STORE_PACKAGE_NAME=
GOOGLE_STORE_PRODUCT_ID=
GOOGLE_STORE_ENVIRONMENT=sandbox
# 已获 Android Publisher 权限的服务账号；不得复用登录 OAuth Web client ID。
GOOGLE_STORE_CLIENT_EMAIL=
GOOGLE_STORE_PRIVATE_KEY=
# Google Pub/Sub authenticated push 的完整 audience 与服务账号 email。
GOOGLE_STORE_NOTIFICATION_AUDIENCE=
GOOGLE_STORE_NOTIFICATION_EMAIL=
# 通知路径：POST /app/store/events/apple 与 /app/store/events/google。
# iOS 商品是非自动续期订阅；Android 为可消耗一次性商品；均30天、quantity=1。

# Sign in with Apple 撤销专用密钥，独立于 App Store Server API 密钥。
# client ID 复用 APPLE_CLIENT_ID；删除前须验证兑换身份并成功撤销。
APPLE_AUTH_TEAM_ID=
APPLE_AUTH_KEY_ID=
APPLE_AUTH_PRIVATE_KEY=

# App 专用公开页面，同一 Express 服务承载；缺完整配置不发布有效政策。
INVITATION_ORIGIN=
APP_OPERATOR_NAME=
APP_SUPPORT_EMAIL=
# 用户已确定：删号后的去标识交易记录及删除标记均保留7天。
# App 启动补清，并每分钟检查到期记录；活账号账本不受影响。
# 网页复用同一策略常量，不接受任意保留期限文案覆盖。
APP_POLICY_EFFECTIVE_DATE=
APP_STORE_URL=
GOOGLE_PLAY_URL=
# Apple 默认复用 APPLE_CLIENT_ID，团队复用 APPLE_AUTH_TEAM_ID。
APPLE_BUNDLE_IDS=
# Android 默认复用 GOOGLE_STORE_PACKAGE_NAME；签名指纹可逗号分隔。
ANDROID_PACKAGE_NAME=
ANDROID_SHA256_CERT_FINGERPRINTS=
