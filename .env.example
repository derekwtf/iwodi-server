# 服务监听
HOST=127.0.0.1
PORT=3010

# 允许访问后端的前端来源（逗号分隔）
# 本地开发可用 http://127.0.0.1:3000 或 *
# 线上请填写你的小程序请求域名 / 管理端域名
CLIENT_ORIGIN=*

# 微信登录（必须配置，否则 /auth/login 与 /auth/wechat-login 会返回 503）
WECHAT_APP_ID=your_wechat_app_id
WECHAT_APP_SECRET=your_wechat_app_secret
WECHAT_LOGIN_TIMEOUT_MS=5000

# 房间空闲/重连相关（按需覆盖）
DISCONNECT_GRACE_MS=30000
HOST_TRANSFER_GRACE_MS=30000
ROOM_ALL_DISCONNECTED_TTL_MS=600000
ROOM_EMPTY_TTL_MS=300000
ROOM_WAITING_IDLE_MS=900000
ROOM_PLAYING_IDLE_MS=600000
ROOM_ENDED_IDLE_MS=300000
ROOM_IDLE_WARNING_MS=60000
VOTE_REMINDER_MS=120000
VOTE_TIMEOUT_MS=180000
