# 服务监听
HOST=127.0.0.1
PORT=3010

# 允许访问后端的前端来源（逗号分隔）
# 本地开发可用 http://127.0.0.1:3000 或 *
# 线上请填写你的小程序请求域名 / 管理端域名
CLIENT_ORIGIN=https://servicewechat.com,https://wodi.server.zhibeii.com

# 微信登录（必须配置，否则 /auth/login 与 /auth/wechat-login 会返回 503）
WECHAT_APP_ID=your_wechat_app_id
WECHAT_APP_SECRET=your_wechat_app_secret
WECHAT_LOGIN_TIMEOUT_MS=5000

# 人数按玩法固定：语言 4～12 人，肢体 3～5 人；不提供全局下限覆盖

# 房间空闲/重连相关（按需覆盖）
HOST_TRANSFER_GRACE_MS=30000
ROOM_ALL_DISCONNECTED_TTL_MS=600000
ROOM_WAITING_IDLE_MS=900000
ROOM_PLAYING_IDLE_MS=600000
ROOM_IDLE_WARNING_MS=60000

# 持久账号（目录须预先创建并允许运行用户写入；放在发布目录外）
USER_DB_PATH=/var/lib/qile-wodi/test/users.sqlite
# 使用 openssl rand -hex 32 生成；测试/正式各自独立，跨发布保留
AUTH_TOKEN_SECRET=

# VIP 道具直购（个人主体，现网 env=0；默认关闭售卖，停卖后保留以下全部密钥）
VIP_PAYMENT_ENABLED=false
VIP_OFFER_ID=
VIP_APP_KEY=
# 已在微信后台创建；须发布生效且价格与下方一致
VIP_PRODUCT_ID=vip_month
VIP_PRICE_FEN=1000
# 消息推送：JSON、安全模式，URL 为 https://本环境域名/wechat/events
WECHAT_MESSAGE_TOKEN=
WECHAT_MESSAGE_AES_KEY=
